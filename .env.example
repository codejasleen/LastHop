# Optional for public GitHub API rate limits; required to create draft PRs.
GITHUB_TOKEN=
# Required for signed push-webhook refreshes.
GITHUB_WEBHOOK_SECRET=
# Required for the final human-approved draft-PR action.
BLASTRADIUS_ADMIN_KEY=
# Keep local unless you intentionally put an authenticated reverse proxy in front.
BLASTRADIUS_BIND=127.0.0.1
